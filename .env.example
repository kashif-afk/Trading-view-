# ============================================================================
# XAUUSD TradingView -> Automated Execution -> Cash-Flow Dashboard (.env.example)
# Copy to `.env` (which is git-ignored). Never commit real keys.
# IMPORTANT: Broker API keys MUST be configured as TRADE-ONLY, WITHDRAWALS DISABLED.
# ============================================================================

# --- Mode & Broker ---
EXECUTION_MODE=paper            # paper | approval | live (MUST start as paper)
BROKER=paper                    # paper | oanda

# --- Secrets (never logged, never stored in DB) ---
WEBHOOK_SECRET=replace-with-strong-32-byte-secret
SESSION_SECRET=replace-with-strong-session-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme123!
ADMIN_TOTP_SECRET=              # Optional Base32 secret for 2FA TOTP login

# --- OANDA v20 Configuration (Trade-Only Key, Withdrawals Disabled) ---
OANDA_ENV=practice              # practice | live
OANDA_ACCOUNT_ID=
OANDA_API_KEY=

# --- Notifications (Telegram Bot) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Economic Calendar (FMP API Key for F3 News Blackout) ---
FMP_API_KEY=

# --- Storage (Local default uses SQLite; docker-compose overrides to Postgres+pgvector) ---
DATABASE_URL=sqlite:///./data/app.db
DATA_DIR=./data

# --- Risk & Sizing Parameters ---
BASE_CURRENCY=USD
ACCOUNT_SIZE=2000
RISK_PER_TRADE_PCT=0.5
MAX_DAILY_LOSS_PCT=2.0
MAX_OPEN_POSITIONS=3
MAX_EXPOSURE_PCT=300
REVENGE_BLOCK_MIN=30
SESSION_START_UTC=07:00
SESSION_END_UTC=20:00
FRIDAY_NO_ENTRY_AFTER_UTC=18:00
NEWS_BLACKOUT_MIN=30
NEWS_FILTER_ENABLED=true

# --- Memory & Learning Layer (Phase 4.5) ---
EMBED_PROVIDER=ollama           # ollama | hash
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
CAUTION_RULE_ENABLED=false
CAUTION_MIN_SAMPLES=20
CAUTION_AVG_R_THRESHOLD=-0.3
CAUTION_ACTION=halve            # halve | approval
